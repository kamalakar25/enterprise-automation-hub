# Windows Worker Agent - Environment Config
PORT=9000
WORKER_TOKEN=shared-secret-change-me

# Path to the folder containing production scripts (VBS + python engine)
# Place these files in this folder:
#   SAP_Daily_Updater_v5_LO.vbs
#   update_excel_structure.py
# Any other supporting files your scripts need
SCRIPTS_DIR=C:\AutomationHub\scripts

# Working directory root — each job gets its own subfolder here
WORK_DIR=C:\AutomationHub\runs

# Python executable (full path if python is not in PATH on the Windows service account)
PYTHON_EXE=python

# Path to cscript.exe (usually just cscript since it's in system32)
CSCRIPT_EXE=cscript

# How long to wait for the VBS stage (SAP GUI updates) in milliseconds (30 min default)
VBS_TIMEOUT_MS=1800000
