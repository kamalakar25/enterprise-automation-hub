# ──────────────────────────────────────────────
# Enterprise Automation Hub — Environment Config
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automation_hub?schema=public"

# Redis (BullMQ queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=8h

# File storage (uploads & generated reports)
UPLOAD_DIR=./storage/uploads
REPORTS_DIR=./storage/reports
MAX_UPLOAD_MB=25

# Windows execution worker (SAP VBScript node)
WINDOWS_WORKER_URL=http://windows-worker.local:9000
WINDOWS_WORKER_TOKEN=shared-secret-change-me

# SMTP (bulk email module)
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=automations@company.com
SMTP_PASS=
SMTP_FROM="Automation Hub <automations@company.com>"

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
